<Window x:Class="LottoWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LottoWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="auto" Width="900" ResizeMode="NoResize">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                <TextBox x:Name="txtOne" HorizontalAlignment="Center" VerticalAlignment="Top" IsEnabled="False" TextAlignment="Left" Margin="0,0,5,0" Width="250" FontFamily="Courier New"/>
                <TextBox x:Name="txtTwo" HorizontalAlignment="Center" VerticalAlignment="Top" IsEnabled="False" TextAlignment="Left" Width="160" FontFamily="Courier New"/>
                <TextBox x:Name="txtThree" HorizontalAlignment="Center" VerticalAlignment="Top" IsEnabled="False" TextAlignment="Left" Margin="5,0,0,0" Width="160" FontFamily="Courier New"/>
            </StackPanel>
        </ScrollViewer>

        <Rectangle HorizontalAlignment="Left" Height="auto" Width="200" Fill="WhiteSmoke"/>

        <CheckBox x:Name="CheckJoker" Content="Do you want jokerrows?" HorizontalAlignment="Left" Margin="5,5,0,0" VerticalAlignment="Top" IsChecked="False"/>
        
        <Button Content="Create Coupon(s)" Click="cmd_CreateCoupon" Width="110" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,50,0,0"/>
        <Button Content="Save Coupon(s)" Click="cmd_SaveTicket" Width="110" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,75,0,0"/>
        
        <ComboBox x:Name="ComboCoupon" Width="80" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,25,0,0">
            <ComboBoxItem IsSelected="True">1</ComboBoxItem>
            <ComboBoxItem>2</ComboBoxItem>
            <ComboBoxItem>3</ComboBoxItem>
            <ComboBoxItem>4</ComboBoxItem>
            <ComboBoxItem>5</ComboBoxItem>
            <ComboBoxItem>6</ComboBoxItem>
            <ComboBoxItem>7</ComboBoxItem>
            <ComboBoxItem>8</ComboBoxItem>
            <ComboBoxItem>9</ComboBoxItem>
            <ComboBoxItem>10</ComboBoxItem>
        </ComboBox>
        
        
    </Grid>
</Window>
